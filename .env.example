# Pure Craft — Analytics Environment Variables
# Copy this file to `.env` and fill in real IDs for production.
# Leave blank in development to disable analytics automatically.

# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
VITE_GA4_ID=

# Meta (Facebook) Pixel ID (e.g., 123456789012345)
VITE_META_PIXEL_ID=
