<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
  <defs>
    <linearGradient id="adGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1e40af;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1e3a8a;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect fill="url(#adGradient)" width="800" height="800"/>
  <!-- Ad dashboard mockup -->
  <rect x="60" y="60" width="680" height="680" fill="rgba(255,255,255,0.05)" rx="20"/>
  <!-- Grid lines -->
  <line x1="100" y1="150" x2="700" y2="150" stroke="rgba(255,255,255,0.1)" stroke-width="2"/>
  <line x1="100" y1="250" x2="700" y2="250" stroke="rgba(255,255,255,0.1)" stroke-width="2"/>
  <line x1="100" y1="350" x2="700" y2="350" stroke="rgba(255,255,255,0.1)" stroke-width="2"/>
  <!-- Chart bars -->
  <rect x="120" y="450" width="40" height="150" fill="rgba(59,130,246,0.6)"/>
  <rect x="190" y="380" width="40" height="220" fill="rgba(59,130,246,0.8)"/>
  <rect x="260" y="320" width="40" height="280" fill="rgba(59,130,246,1)"/>
  <rect x="330" y="350" width="40" height="250" fill="rgba(59,130,246,0.9)"/>
  <rect x="400" y="300" width="40" height="300" fill="rgba(59,130,246,1)"/>
  <circle cx="200" cy="150" r="8" fill="#60a5fa"/>
  <circle cx="300" cy="150" r="8" fill="#f97316"/>
</svg>