<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
  <defs>
    <linearGradient id="reportGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#15803d;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0f6338;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect fill="url(#reportGradient)" width="800" height="800"/>
  <!-- Line chart -->
  <polyline points="120,600 220,480 320,520 420,320 520,380 620,200 720,250" 
            fill="none" stroke="rgba(34,197,94,0.8)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
  <!-- Fill under curve -->
  <polygon points="120,600 220,480 320,520 420,320 520,380 620,200 720,250 720,700 120,700" 
           fill="rgba(34,197,94,0.2)"/>
  <!-- Data points -->
  <circle cx="120" cy="600" r="8" fill="rgba(34,197,94,1)"/>
  <circle cx="220" cy="480" r="8" fill="rgba(34,197,94,1)"/>
  <circle cx="320" cy="520" r="8" fill="rgba(34,197,94,0.9)"/>
  <circle cx="420" cy="320" r="8" fill="rgba(34,197,94,1)"/>
  <circle cx="520" cy="380" r="8" fill="rgba(34,197,94,0.9)"/>
  <circle cx="620" cy="200" r="8" fill="rgba(34,197,94,1)"/>
  <circle cx="720" cy="250" r="8" fill="rgba(34,197,94,1)"/>
  <!-- Grid lines -->
  <line x1="80" y1="200" x2="750" y2="200" stroke="rgba(34,197,94,0.15)" stroke-width="1" stroke-dasharray="5,5"/>
  <line x1="80" y1="350" x2="750" y2="350" stroke="rgba(34,197,94,0.15)" stroke-width="1" stroke-dasharray="5,5"/>
  <line x1="80" y1="500" x2="750" y2="500" stroke="rgba(34,197,94,0.15)" stroke-width="1" stroke-dasharray="5,5"/>
  <!-- Axis -->
  <line x1="80" y1="700" x2="750" y2="700" stroke="rgba(34,197,94,0.4)" stroke-width="2"/>
  <line x1="80" y1="100" x2="80" y2="700" stroke="rgba(34,197,94,0.4)" stroke-width="2"/>
</svg>