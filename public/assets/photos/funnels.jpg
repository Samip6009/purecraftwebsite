<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
  <defs>
    <linearGradient id="funnelGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#6b21a8;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#581c87;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect fill="url(#funnelGradient)" width="800" height="800"/>
  <!-- Funnel visualization -->
  <polygon points="150,150 650,150 600,300 200,300" fill="rgba(168,85,247,0.4)" stroke="rgba(168,85,247,0.8)" stroke-width="3"/>
  <polygon points="200,300 600,300 550,450 250,450" fill="rgba(168,85,247,0.6)" stroke="rgba(168,85,247,0.8)" stroke-width="3"/>
  <polygon points="250,450 550,450 480,600 320,600" fill="rgba(168,85,247,0.8)" stroke="rgba(168,85,247,0.8)" stroke-width="3"/>
  <polygon points="320,600 480,600 400,700 400,700" fill="rgba(168,85,247,1)" stroke="rgba(168,85,247,1)" stroke-width="3"/>
  <!-- Labels -->
  <text x="400" y="210" text-anchor="middle" fill="rgba(255,255,255,0.7)" font-size="32" font-weight="bold">Awareness</text>
  <text x="400" y="365" text-anchor="middle" fill="rgba(255,255,255,0.8)" font-size="32" font-weight="bold">Interest</text>
  <text x="400" y="520" text-anchor="middle" fill="rgba(255,255,255,0.9)" font-size="32" font-weight="bold">Decision</text>
  <text x="400" y="680" text-anchor="middle" fill="rgba(255,255,255,1)" font-size="32" font-weight="bold">Action</text>
</svg>