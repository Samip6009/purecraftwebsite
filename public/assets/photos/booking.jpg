<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
  <defs>
    <linearGradient id="bookingGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#9a3412;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#7c2d12;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect fill="url(#bookingGradient)" width="800" height="800"/>
  <!-- Calendar grid -->
  <rect x="100" y="80" width="600" height="680" fill="rgba(249,115,22,0.1)" stroke="rgba(249,115,22,0.3)" stroke-width="2" rx="10"/>
  <!-- Day headers -->
  <text x="170" y="140" text-anchor="middle" fill="rgba(255,255,255,0.6)" font-size="20" font-weight="bold">Mon</text>
  <text x="260" y="140" text-anchor="middle" fill="rgba(255,255,255,0.6)" font-size="20" font-weight="bold">Tue</text>
  <text x="350" y="140" text-anchor="middle" fill="rgba(255,255,255,0.6)" font-size="20" font-weight="bold">Wed</text>
  <text x="440" y="140" text-anchor="middle" fill="rgba(255,255,255,0.6)" font-size="20" font-weight="bold">Thu</text>
  <text x="530" y="140" text-anchor="middle" fill="rgba(255,255,255,0.6)" font-size="20" font-weight="bold">Fri</text>
  <text x="620" y="140" text-anchor="middle" fill="rgba(255,255,255,0.6)" font-size="20" font-weight="bold">Sat</text>
  <!-- Booked slots -->
  <rect x="130" y="180" width="70" height="70" fill="rgba(34,197,94,0.6)" rx="5"/>
  <rect x="310" y="180" width="70" height="70" fill="rgba(34,197,94,0.6)" rx="5"/>
  <rect x="490" y="180" width="70" height="70" fill="rgba(34,197,94,0.6)" rx="5"/>
  <rect x="130" y="280" width="70" height="70" fill="rgba(34,197,94,0.7)" rx="5"/>
  <rect x="400" y="280" width="70" height="70" fill="rgba(34,197,94,0.7)" rx="5"/>
  <rect x="580" y="280" width="70" height="70" fill="rgba(34,197,94,0.7)" rx="5"/>
  <!-- Check marks -->
  <text x="165" y="220" text-anchor="middle" fill="white" font-size="40" font-weight="bold">✓</text>
  <text x="345" y="220" text-anchor="middle" fill="white" font-size="40" font-weight="bold">✓</text>
  <text x="525" y="220" text-anchor="middle" fill="white" font-size="40" font-weight="bold">✓</text>
</svg>