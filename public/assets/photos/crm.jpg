<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800">
  <defs>
    <linearGradient id="crmGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#831843;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#6b1635;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect fill="url(#crmGradient)" width="800" height="800"/>
  <!-- CRM database mockup -->
  <rect x="80" y="100" width="640" height="600" fill="rgba(236,72,153,0.1)" stroke="rgba(236,72,153,0.3)" stroke-width="2" rx="10"/>
  <!-- Rows -->
  <rect x="100" y="130" width="600" height="70" fill="rgba(236,72,153,0.2)"/>
  <rect x="100" y="220" width="600" height="70" fill="rgba(236,72,153,0.15)"/>
  <rect x="100" y="310" width="600" height="70" fill="rgba(236,72,153,0.2)"/>
  <rect x="100" y="400" width="600" height="70" fill="rgba(236,72,153,0.15)"/>
  <rect x="100" y="490" width="600" height="70" fill="rgba(236,72,153,0.2)"/>
  <!-- Column dividers -->
  <line x1="200" y1="130" x2="200" y2="560" stroke="rgba(236,72,153,0.2)" stroke-width="1"/>
  <line x1="350" y1="130" x2="350" y2="560" stroke="rgba(236,72,153,0.2)" stroke-width="1"/>
  <line x1="500" y1="130" x2="500" y2="560" stroke="rgba(236,72,153,0.2)" stroke-width="1"/>
  <!-- Contact icons -->
  <circle cx="150" cy="165" r="8" fill="rgba(236,72,153,0.6)"/>
  <circle cx="150" cy="255" r="8" fill="rgba(236,72,153,0.6)"/>
  <circle cx="150" cy="345" r="8" fill="rgba(236,72,153,0.6)"/>
  <circle cx="150" cy="435" r="8" fill="rgba(236,72,153,0.6)"/>
  <circle cx="150" cy="525" r="8" fill="rgba(236,72,153,0.6)"/>
  <!-- Connection dots -->
  <circle cx="250" cy="165" r="5" fill="rgba(236,72,153,0.5)"/>
  <circle cx="400" cy="165" r="5" fill="rgba(236,72,153,0.4)"/>
  <circle cx="550" cy="165" r="5" fill="rgba(236,72,153,0.3)"/>
</svg>